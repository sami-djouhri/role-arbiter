# /etc/default/wake-bridge auf dem Spiele-VPS.
# 0.0.0.0 statt Loopback, weil das Dashboard im Docker-Netz sitzt und den Wirt ueber
# host.docker.internal anspricht -- ueber Loopback waere es fuer den Container nicht da.
# Nach aussen bleibt der Port durch 'ufw default deny incoming' zu; erlaubt ist nur das
# Docker-Subnetz des Dashboards. Der Discord-Bot kommt durch einen SSH-Tunnel und landet
# auf 127.0.0.1 -- auch das deckt 0.0.0.0 ab.
WAKE_BIND=0.0.0.0
WAKE_PORT=8129
